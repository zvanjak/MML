      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-default",
      "displayName": "Linux Debug (System Default)",
      "description": "Debug build with system default compiler",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
