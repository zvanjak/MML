        "rhs": "Linux"
      }
    },
    {
      "name": "windows-default",
      "displayName": "Windows x64 Debug",
      "description": "Default Windows configuration with Visual Studio",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
